	partition Fact_Network = m
		mode: import
		source =
				let
				  Source = Folder.Files("C:\Users\owner\Downloads\Data\WE_DATA\Fact_Network"),
				  #"Filtered hidden files" = Table.SelectRows(Source, each [Attributes]?[Hidden]? <> true),
				  #"Added custom" = let
